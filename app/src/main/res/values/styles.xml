<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ✅ FINAL APP THEME -->
    <style name="AppTheme" parent="Theme.Material3.Light.NoActionBar">

        <!-- App primary colors -->
        <item name="colorPrimary">@color/my_app_primary</item>
        <item name="colorPrimaryContainer">@color/my_app_primary</item>
        <item name="colorOnPrimary">@android:color/white</item>

        <!-- ✅ STATUS BAR FIX (MOST IMPORTANT) -->
        <item name="android:statusBarColor">@color/my_app_primary</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Background -->
        <item name="android:windowBackground">@android:color/white</item>
    </style>

    <!-- 📅 Custom CalendarView Style (UNCHANGED) -->
    <style name="CustomCalendarView" parent="android:Widget.Material.CalendarView">
        <item name="android:selectedWeekBackgroundColor">@android:color/transparent</item>
        <item name="android:weekSeparatorLineColor">@android:color/transparent</item>
        <item name="android:dateTextAppearance">@style/CalendarDateText</item>
        <item name="android:weekDayTextAppearance">@style/CalendarWeekDayText</item>
        <item name="android:focusedMonthDateColor">@color/black</item>
        <item name="android:unfocusedMonthDateColor">@color/gray</item>
    </style>

    <style name="CalendarDateText" parent="@android:style/TextAppearance.Small">
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="CalendarWeekDayText" parent="@android:style/TextAppearance.Small">
        <item name="android:textColor">@color/purple_700</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
    </style>

</resources>
